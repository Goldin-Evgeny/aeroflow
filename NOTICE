  apps/studio/public/benchmarks/aij/case-e/{fixture.json,geometry.glb}
      from CaseE(Niigata).xls and CaseE_dxf.zip
      sha256 6c4421a81d8f4c7199e83bd02958f8fae0f2701e041f1f0bcd4e25a5981a25d1 (xls)
      sha256 58d0f99015f874eec1cb7f881e736f6643268c504bcf4eeae6b652388383158f (dxf)
